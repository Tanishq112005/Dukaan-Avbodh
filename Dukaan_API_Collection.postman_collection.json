      "item": [
        {
          "name": "Stream Chat Message (SSE Stream)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "text/event-stream",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/message/stream",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "message",
                "stream"
              ]
            },
            "description": "Streams LangGraph execution events, real-time node updates (Director, Recommendation, Cart, Negotiation, Tools), token deltas, and final structured response via Server-Sent Events (SSE).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 1,\n  \"text\": \"Recommend me some stylish men blue jeans and tell me what discount you can offer\",\n  \"thread_id\": \"{{threadId}}\",\n  \"cart\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
