# =============================================================================
# Dukaan Backend Environment Configuration Template
# =============================================================================
# Copy this file to '.env' in the backend directory and replace the placeholder
# values with your actual service credentials before running the application.
#
#   cp .env.example .env
#
# IMPORTANT: Never commit '.env' or real credentials into version control.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. PRIMARY DATABASES
# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL (Relational DB for users, products, orders, inventory, policies)
# Neon / Supabase / Local PostgreSQL connection string (asyncpg driver required)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/dukaan?ssl=require

# MongoDB (Document store for multi-turn LangGraph agent states and chat history)
MONGODB_URL=mongodb://localhost:27017/dukaan_db

# Redis (Caching, pub/sub, live session memory, rate limiting, and task queue)
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# 2. MESSAGE BROKER & ASYNC TASK QUEUE
# ─────────────────────────────────────────────────────────────────────────────
# RabbitMQ AMQP connection string for asynchronous event processing & worker tasks
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ─────────────────────────────────────────────────────────────────────────────
# 3. AI & LLM PROVIDERS
# ─────────────────────────────────────────────────────────────────────────────
# OpenRouter API Key(s) used for multi-model LLM inference (supports single or comma-separated keys for rotation)
OPEN_ROUTER_KEYS=sk-or-v1-your_openrouter_api_key_here
OPEN_ROUTER_KEY=sk-or-v1-your_openrouter_api_key_here

# Google Gemini API Key for Gemini models (e.g., gemini-1.5-flash / gemini-2.0-flash)
GOOGLE_API_KEY=AIzaSyYourGoogleApiKeyHere

# Groq API Key for ultra-low latency inference (e.g., Llama-3, Mixtral)
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenAI API Key for GPT models
OPEN_API_KEY=sk-your_openai_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# 4. EMBEDDINGS & VECTOR SEARCH
# ─────────────────────────────────────────────────────────────────────────────
# Pinecone API Key for vector database product catalog search
PINECONE_API_KEY=pcsk_your_pinecone_api_key_here

# HuggingFace API Key for inference API & embedding generation
HUGGINGFACE_API_KEY=hf_your_huggingface_api_key_here

# Jina AI API Key for embeddings / reranking
JINA_API_KEY=jina_your_jina_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# 5. MODEL CONTEXT PROTOCOL (MCP) SERVERS
# ─────────────────────────────────────────────────────────────────────────────
# FastMCP Bearer Token for securing MCP endpoints (optional)
FASTMCP_TOKEN=your_fastmcp_auth_token_here

# Dukaan User Agent MCP Server SSE URL (local: http://127.0.0.1:8001/sse)
MCP_USER_SERVER_URL=http://127.0.0.1:8001/sse

# Dukaan Merchant Agent MCP Server SSE URL (local: http://127.0.0.1:8002/sse)
MCP_MERCHANT_SERVER_URL=http://127.0.0.1:8002/sse

# ─────────────────────────────────────────────────────────────────────────────
# 6. PAYMENT GATEWAYS
# ─────────────────────────────────────────────────────────────────────────────
# Default payment provider to use ("razorpay")
DEFAULT_PAYMENT_PROVIDER=razorpay

# Razorpay Test / Live Key ID (public key for frontend checkout widgets)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

# Razorpay Key Secret (private secret for HMAC signature verification & API calls)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Webhook Secret for cryptographically verifying payment webhook payloads
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─────────────────────────────────────────────────────────────────────────────
# 7. NOTIFICATIONS & TRANSACTIONAL EMAIL
# ─────────────────────────────────────────────────────────────────────────────
# Brevo (formerly Sendinblue) API Key for transactional order confirmation emails
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Verified Sender Email Address in Brevo
BREVO_SENDER_EMAIL=noreply@dukaan.com

# Display Name for Email Sender
BREVO_SENDER_NAME=Dukaan Store

# Alternative fallback environment variables supported by BrevoEmailProvider:
# EMAIL_SENDER_ADDRESS=noreply@dukaan.com
# EMAIL_SENDER_NAME=Dukaan Store
# SENDINBLUE_API_KEY=xkeysib-your_brevo_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# 8. APPLICATION & SECURITY
# ─────────────────────────────────────────────────────────────────────────────
# Secret key used for signing and verifying JWT authentication tokens (min 32 chars)
JWT_SECRET=your_super_secret_jwt_signing_key_change_in_production

# Frontend application URL for CORS configuration and payment redirect callbacks
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# 9. OBSERVABILITY & TRACING (LANGSMITH)
# ─────────────────────────────────────────────────────────────────────────────
# Enable/disable LangSmith tracing for LangChain / LangGraph execution ("true" or "false")
LANGSMITH_TRACING=true

# LangSmith API Key from smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key_here

# LangSmith API Endpoint
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# LangSmith Project Name
LANGSMITH_PROJECT=dukaan-agent

# ─────────────────────────────────────────────────────────────────────────────
# 10. AGENT STATE CHECKPOINTERS & WORKER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# LangGraph Checkpointer storage type: "memory" (fastest, ephemeral), "redis", or "mongodb"
CHECKPOINTER_TYPE=memory

# Redis keyspace prefixes for LangGraph state persistence
REDIS_CHECKPOINT_PREFIX=checkpoint:user_agent
REDIS_CHECKPOINT_WRITE_PREFIX=checkpoint_write:user_agent
REDIS_MERCHANT_CHECKPOINT_PREFIX=checkpoint:merchant_agent
REDIS_MERCHANT_CHECKPOINT_WRITE_PREFIX=checkpoint_write:merchant_agent

# TTL for Redis checkpoints in seconds (default: 86400 = 24 hours)
REDIS_CHECKPOINT_TTL=86400

# Chat summarizer worker trigger threshold (message interval before summarizing)
SUMMARIZER_TRIGGER_THRESHOLD=8
